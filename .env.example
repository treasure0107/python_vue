# 复制为项目根目录 .env 后按需修改（勿提交 .env）

# 本地 MySQL 8（库名 toutiao）
DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/toutiao?charset=utf8mb4
DEBUG=true

# 本地未安装 Redis 时保持 false，避免接口卡顿
REDIS_ENABLED=false

# 仅用 SQLite 时：
# DATABASE_URL=sqlite:///./backend/toutiao.db

# Docker Compose 默认仍为 SQLite 卷：
# DATABASE_URL=sqlite:////data/toutiao.db
